{
  "name": "slowread-app",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "CONTENT_REPO": "gmij/slowread-library",
    "CONTENT_REF": "main",
    "TRANSLATION_ENABLED": "true"
  },
  "ai": {
    "binding": "AI"
  }
}