{
  "name": "slowread-app",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "CONTENT_REPO": "gmij/slowread-library",
    "CONTENT_REF": "main",
    "TRANSLATION_ENABLED": "true",
    "BOOK_REQUESTS_ENABLED": "true",
    "TRANSLATION_DAILY_CHARACTERS": "100000"
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {"name":"BOOKSHELVES","class_name":"UserBookshelf"},
      {
        "name": "TRANSLATIONS",
        "class_name": "TranslationCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-translation-coordinator",
      "new_sqlite_classes": [
        "TranslationCoordinator"
      ]
    },
    {"tag":"v2-user-bookshelves","new_sqlite_classes":["UserBookshelf"]}
  ]
}
